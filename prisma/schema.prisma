// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A real account on the site (email + password), separate from the
// Instagram account it connects. Every other model that used to assume
// "the one creator using this app" now hangs off userId instead - see
// each model's own comment for whether it carries userId directly or is
// scoped indirectly through a parent relation.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Nullable only to represent an "unclaimed" bootstrap row created by the
  // migration that introduced this table, for any data that existed
  // before multi-user accounts did - see that migration's SQL. A null
  // here means "no password set yet," not a bug; login always rejects it,
  // and signup treats a matching unclaimed email as a claim (sets the
  // password) rather than a duplicate-email error.
  passwordHash String?
  createdAt    DateTime @default(now())

  account           Account?
  followerSnapshots FollowerSnapshot[]
  reels             Reel[]
  series            Series[]
  posts             Post[]
  agentDefinitions  AgentDefinition[]
  agentSettings     AgentSettings?
  suggestions       Suggestion[]
  contentDnaProfiles ContentDnaProfile[]
  bestPractices     BestPractice[]
  ideaBatches       IdeaBatch[]
  dmThreads         DmThread[]
  calendarEntries   CalendarEntry[]
  draftReels        DraftReel[]
  dailyReports      DailyReport[]
}

// The connected Instagram professional account - one per User.
model Account {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  igUserId       String   @unique
  username       String
  accountType    String?
  accessToken    String
  tokenExpiresAt DateTime
  connectedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Point-in-time snapshot of account-level stats, captured on every sync.
// Historical rows (not just the latest) are what makes the followers
// growth chart possible.
model FollowerSnapshot {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  capturedAt    DateTime @default(now())
  followerCount Int
  followsCount  Int
  mediaCount    Int
  // Daily follows_and_unfollows from Instagram's account insights, captured
  // at sync time. Null when the account has under 100 followers (the
  // metric isn't returned) or the request fails - this is an addition on
  // top of the API's own documented limits, not a sync-breaking error.
  newFollows    Int?
  newUnfollows  Int?

  @@index([userId])
}

model Reel {
  id               String                @id @default(cuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  igMediaId        String                @unique
  permalink        String
  caption          String?
  postedAt         DateTime
  thumbnailUrl     String?
  mediaProductType String?
  // Agent-assigned during sync (see lib/content/classify.ts). Null until
  // classified; topicTags is a JSON-encoded string array.
  format           String?
  topicTags        String?
  // The Graph API doesn't expose a reel's own duration as a field -
  // probed from the raw video file via ffmpeg during sync instead (see
  // lib/video/duration.ts), once, since it never changes after posting.
  durationMs       Int?
  // AI-generated "why did this perform the way it did" narrative, grounded
  // in the feedback-loop baselines (see lib/feedback.ts) - user-triggered,
  // not generated automatically, and re-runnable since more insight
  // snapshots accrue over time. Null until first run.
  performanceAnalysis   String?
  performanceAnalysisAt DateTime?
  // AI hypothesis (not measured data - the Graph API exposes no per-second
  // retention curve) about where in the reel viewers likely dropped off,
  // inferred from its actual frames plus its real average-retention
  // number. See lib/agents/tasks/retention-hypothesis.ts.
  retentionHypothesis   String?
  retentionHypothesisAt DateTime?
  seriesId         String?
  series           Series?               @relation(fields: [seriesId], references: [id])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  insights         ReelInsightSnapshot[]

  @@index([userId])
  @@index([seriesId])
}

// A user-defined group of reels tracked as a single narrative arc (e.g.
// "Account Growth Journey"), shown from its start date.
model Series {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  startDate   DateTime @default(now())
  createdAt   DateTime @default(now())
  reels       Reel[]

  @@index([userId])
}

// Point-in-time snapshot of a single reel's stats. Scoped indirectly
// through its Reel (already userId-scoped) rather than carrying its own
// userId - every query reaches this through a Reel that was itself
// already verified to belong to the current user.
model ReelInsightSnapshot {
  id                String   @id @default(cuid())
  reelId            String
  reel              Reel     @relation(fields: [reelId], references: [id])
  capturedAt        DateTime @default(now())
  views             Int?
  likes             Int?
  comments          Int?
  shares            Int?
  saved             Int?
  reach             Int?
  totalInteractions Int?
  avgWatchTimeMs    Int?
  skipRate3s        Float?
  engagementRate    Float?

  @@index([reelId])
}

// One row per agent per user (src/lib/agents/registry.ts). Seeded
// automatically on first access rather than via a separate seed script.
model AgentDefinition {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  name        String
  description String
  // "off" | "daily" | "weekly" | "monthly" - "off" only stops the
  // scheduler from auto-triggering; manually hitting "Run now" always
  // works regardless of this value. hour is UTC, 0-23. dayOfWeek (0=Sun)
  // only applies when frequency="weekly"; dayOfMonth (1-28) only applies
  // when frequency="monthly".
  frequency   String     @default("daily")
  hour        Int        @default(6)
  // 5-minute increments only (0, 5, 10, ... 55) - matches the scheduler's
  // own 5-minute poll granularity (see agents/scheduler.ts), so any value
  // in between could never actually fire.
  minute      Int        @default(0)
  dayOfWeek   Int        @default(1)
  dayOfMonth  Int        @default(1)
  createdAt   DateTime   @default(now())
  runs        AgentRun[]

  @@unique([userId, key])
}

// Per-user settings that shape what the Idea/Planning agents suggest.
model AgentSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Free text (one topic/thing per line) the creator never wants
  // suggested - fed into the Idea and Planning agent prompts verbatim.
  excludedTopics String?
  updatedAt      DateTime @updatedAt
}

// Scoped indirectly through AgentDefinition (agent.userId), not its own
// userId column.
model AgentRun {
  id            String          @id @default(cuid())
  agentId       String
  agent         AgentDefinition @relation(fields: [agentId], references: [id])
  status        String // "running" | "succeeded" | "failed" | "skipped"
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?
  outputSummary String?
  logs          AgentLogEntry[]

  @@index([agentId])
}

model AgentLogEntry {
  id        String   @id @default(cuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id])
  timestamp DateTime @default(now())
  level     String // "info" | "warn" | "error"
  message   String

  @@index([runId])
}

// The Planning agent's daily "post this" output, surfaced on Overview.
// type "reel" uses hook/script; type "post"/"story" use concept/caption
// instead - the shapes don't share fields.
model Suggestion {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime @default(now())
  type             String   @default("reel") // "reel" | "post" | "story"
  hook             String?
  script           String?
  concept          String?
  caption          String?
  sourceAgentRunId String?
  status           String   @default("new") // "new" | "used" | "dismissed"
  createdAt        DateTime @default(now())

  @@index([userId])
}

// Versioned snapshot of "what consistently works" for this creator, built by
// the Analytics agent from historical top performers. Kept as a history
// (not a single row) so the Content DNA page can show how it's evolved.
model ContentDnaProfile {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedAt       DateTime @default(now())
  narrative         String
  topFormatsJson    String // JSON: [{ format, avgViews, count }]
  topTopicsJson     String // JSON: [{ topic, avgViews, count }]
  sourceAgentRunId  String?

  @@index([userId])
}

// High-conviction, durable recommendations ("you should really do X") the
// Analytics agent surfaces after scanning full content history - unlike
// Suggestion (a new daily rotating hook/script/caption), these persist
// until the creator marks them done or dismisses them, and the agent is
// told about existing open/resolved ones each run so it doesn't repeat
// itself.
model BestPractice {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String
  status           String   @default("open") // "open" | "done" | "dismissed"
  sourceAgentRunId String?
  createdAt        DateTime @default(now())
  resolvedAt       DateTime?

  @@index([userId])
}

// The Idea agent's raw output, split into two distinct buckets rather
// than one mixed list, so the UI can show "from your niche" and "new
// territory" as genuinely separate sections instead of a label buried in
// free text (see planning.ts, which still reads the combined text via
// AgentRun.outputSummary for backward-compatible prompt construction).
model IdeaBatch {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedAt      DateTime @default(now())
  nicheIdeasJson   String // JSON: [{ concept, why }]
  freshIdeasJson   String // JSON: [{ concept, why }]
  sourceAgentRunId String?

  @@index([userId])
}

// A DM conversation, populated by the Instagram Messaging webhook receiver
// (src/app/api/instagram/webhook/route.ts) — not reachable until that
// webhook is registered with a publicly-accessible URL. The DM agent reads
// unhandled threads, categorizes them, and drafts a reply for review;
// nothing is ever sent automatically.
model DmThread {
  id                  String      @id @default(cuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The other participant's Instagram id - unique per user, not
  // globally, since two CMPND users can both be DMing the same person.
  igThreadId          String
  participantUsername String?
  category            String? // "question" | "collab" | "fan" | "spam" | "business" | "other"
  draftReply          String?
  draftStatus         String      @default("none") // "none" | "drafted" | "sent" | "dismissed"
  lastMessageAt        DateTime
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  messages            DmMessage[]

  @@unique([userId, igThreadId])
  @@index([userId])
}

// Scoped indirectly through its DmThread, same reasoning as
// ReelInsightSnapshot.
model DmMessage {
  id          String   @id @default(cuid())
  threadId    String
  thread      DmThread @relation(fields: [threadId], references: [id])
  // Unique per thread, not globally - when two CMPND users DM each other,
  // the same message arrives as a webhook event for both accounts.
  igMessageId String
  fromUser    Boolean // true = sent by the DM participant, false = sent by the account owner
  text        String?
  sentAt      DateTime

  @@unique([threadId, igMessageId])
  @@index([threadId])
}

// Feed content (photos, carousels) — tracked separately from Reel since
// video-specific concepts (avg watch time, hook/script format
// classification) don't apply. mediaType stands in for "format."
model Post {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  igMediaId String                @unique
  permalink String
  caption   String?
  postedAt  DateTime
  thumbnailUrl String?
  mediaType String // "IMAGE" | "CAROUSEL_ALBUM" | "VIDEO"
  topicTags String? // JSON-encoded string array, same convention as Reel
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  insights  PostInsightSnapshot[]

  @@index([userId])
}

// Scoped indirectly through its Post, same reasoning as
// ReelInsightSnapshot.
model PostInsightSnapshot {
  id                String   @id @default(cuid())
  postId            String
  post              Post     @relation(fields: [postId], references: [id])
  capturedAt        DateTime @default(now())
  views             Int?
  likes             Int?
  comments          Int?
  shares            Int?
  saved             Int?
  reach             Int?
  totalInteractions Int?
  engagementRate    Float?

  @@index([postId])
}

// An in-progress reel uploaded for pre-publish feedback (the "Scanner").
// storagePath points at a file on the Railway Volume (or local .data/
// fallback in dev) — see src/lib/video/draft-storage.ts. analysisJson is
// only populated once status reaches "analyzed".
model DraftReel {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename     String
  storagePath  String
  status       String    @default("uploaded") // "uploaded" | "processing" | "analyzed" | "failed"
  error        String?
  analysisJson String? // JSON: { breakdown: [{area, suggestion}], hook, caption }
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

// A planned (not yet posted) piece of content for a specific date - purely
// an organizational/planning record, not tied to Instagram in any way
// until the creator actually posts it themselves. The calendar overlays
// these with real Reel/Post postedAt dates for a combined
// planned-vs-actual view, but that overlay is computed at read time, not
// a stored link - see lib/calendar.ts.
model CalendarEntry {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime
  contentType        String // "reel" | "post" | "story"
  title              String // the hook, or a short post concept
  notes              String? // script, caption, or free notes
  status             String   @default("planned") // "planned" | "drafted" | "posted" | "skipped"
  sourceSuggestionId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([date])
}

// The daily capstone - runs last in the agent pipeline (after sync,
// analytics, trend, idea, planning) so it can synthesize all of their
// output into one dated briefing. statsJson is a frozen snapshot (not
// re-derived at read time) so an old report still shows the numbers as
// they were that day, even as history keeps accruing.
model DailyReport {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime  @default(now())
  summary          String
  statsJson        String
  emailSentAt      DateTime?
  emailError       String?
  sourceAgentRunId String?
  createdAt        DateTime  @default(now())

  @@index([userId])
}
