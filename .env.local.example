# Copy this file to .env.local and fill in the values.
# See the Settings page in the app for step-by-step setup instructions.

# From your Meta app's Basic Settings page (developers.facebook.com/apps)
IG_APP_ID=
IG_APP_SECRET=

# Must exactly match a redirect URI registered in the Instagram product's
# Business Login settings.
IG_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# From console.anthropic.com — used to auto-classify each reel's format/topics
# during sync, and to run the daily content agents.
ANTHROPIC_API_KEY=

# Optional — only needed for the DM Manager agent (see the DMs page for full
# setup). Any string you choose; must match the verify token you configure
# on the webhook subscription in the Meta app dashboard.
IG_WEBHOOK_VERIFY_TOKEN=
